{
  "go.toolsManagement.autoUpdate": true,
  "[go]": { "editor.formatOnSave": true },
  "python.defaultInterpreterPath": "${workspaceFolder}/ai-pipeline/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/ai-pipeline",
  "python.testing.pytestArgs": ["tests"],
  "yaml.validate": true,
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/*.egg-info": true },
  "search.exclude": { "rules-staging/**": true, "web-portal/node_modules/**": true, "web-portal/.next/**": true }
}
