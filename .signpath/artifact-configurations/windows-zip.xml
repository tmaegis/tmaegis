<?xml version="1.0" encoding="utf-8"?>
<!-- Upload this in SignPath (project > artifact configuration, slug: windows-zip).
     The GitHub artifact is a zip that contains the release zips, hence the nested zip-file. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <zip-file path="*.zip" max-matches="unbounded">
      <pe-file path="tmaegis.exe" min-matches="0" max-matches="unbounded">
        <authenticode-sign/>
      </pe-file>
      <pe-file path="*/tmaegis-desktop.exe" min-matches="0" max-matches="unbounded">
        <authenticode-sign/>
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
